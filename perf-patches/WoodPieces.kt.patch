+        try { colors.map { stain(grain, it) } } finally { grain.recycle() }
+    }
+    private val polygon = Path() // Synchronous draw calls only; never retain in a scene.
+    private val edgeStroke = Stroke(width = 1.4f, join = StrokeJoin.Round)
